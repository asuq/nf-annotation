/*
 * Opt-in OIST storage placement for large cohorts. Use with `-profile oist`
 * and pass `-work-dir` explicitly so resumed runs reuse the same persistent
 * work directory. Retry times and partitions come from the run's resource
 * configuration; this file changes only task storage placement.
 */
process {
    scratch = '/scratch'
    // Some processes emit both a directory and a file within it. Copying
    // declared outputs avoids a second stage-out trying to move a missing file.
    stageOutMode = 'copy'

    withName: STAGE_INPUTS {
        executor = 'slurm'
    }

    // Keep the prepared ANI inputs on shared storage so hard links can target
    // the staged FASTAs.
    withName: BUILD_FASTANI_INPUTS {
        scratch = false
    }

    // Keep the second FastANI copy on node-local scratch only.
    withName: FASTANI {
        scratch = '/scratch'
        stageInMode = 'copy'
        stageOutMode = 'copy'
    }
}
