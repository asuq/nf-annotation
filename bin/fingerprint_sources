#!/usr/bin/env python3
"""Execution-only parallel fingerprint driver; scientific validators are unchanged."""

import argparse
from pathlib import Path

from annotation_common import AnnotationError, read_json, write_json
from fingerprinting.source_fingerprint import FingerprintScanner
from reuse_source_validation import validate_or_reuse
from publication_references import PORTABLE_CONTRACT, REFERENCE_CONTRACT


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--sources", type=Path, required=True)
    parser.add_argument("--output", type=Path, required=True)
    parser.add_argument("--metrics", type=Path, required=True)
    parser.add_argument("--progress", type=Path, required=True)
    parser.add_argument("--workers", type=int, required=True)
    parser.add_argument("--receipts", type=Path, required=True)
    parser.add_argument("--previous", type=Path)
    args = parser.parse_args()
    try:
        roots = [Path(value) for value in read_json(args.sources)]
        for root in roots:
            if read_json(root / 'annotation_results.json').get('pipeline_contract') not in (PORTABLE_CONTRACT, REFERENCE_CONTRACT):
                raise AnnotationError('Reuse requires v0.5 publications; v0.4 inputs are unsupported')
        with FingerprintScanner(args.workers, progress=args.progress, requested_roots=len(roots)) as scanner:
            records = []
            for root in roots:
                records.append(scanner.fingerprint(root))
                scanner.metrics["completed_roots"] += 1
            scanner.metrics["phase"] = "validating"
            scanner.report(force=True)
            receipts, reused = validate_or_reuse(roots, records, args.previous, checksum=scanner.checksum)
            scanner.metrics["semantic_validation_reused"] = reused
        metrics = scanner.metrics
        write_json(args.receipts, receipts)
        write_json(args.output, records)
        write_json(args.metrics, metrics)
    except (AnnotationError, OSError, ValueError, KeyError) as error:
        parser.exit(1, str(error) + "\n")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
